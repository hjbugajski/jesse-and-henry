{
  "name": "jesse-and-henry",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --turbopack",
    "i:dev": "infisical run pnpm dev",
    "dev:clean": "rm -rf .next && rm -rf next-env.d.ts && pnpm dev",
    "i:dev:clean": "infisical run pnpm dev:clean",
    "build": "next build",
    "i:build": "infisical run pnpm build",
    "build:clean": "rm -rf .next && rm -rf next-env.d.ts && pnpm build",
    "i:build:clean": "infisical run pnpm build:clean",
    "start": "next start",
    "i:start": "infisical run pnpm start",
    "migrate": "payload migrate",
    "i:migrate": "infisical run pnpm migrate",
    "migrate:create": "payload migrate:create",
    "i:migrate:create": "infisical run pnpm migrate:create",
    "generate:importmap": "infisical run payload generate:importmap",
    "generate:types": "infisical run payload generate:types",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint --type-aware --fix",
    "lint:check": "oxlint --type-aware",
    "stylelint": "stylelint '**/*.css' --fix --ignore-path .gitignore",
    "stylelint:check": "stylelint '**/*.css' --ignore-path .gitignore",
    "typecheck": "tsc --noEmit",
    "prepare": "simple-git-hooks"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@payloadcms/db-postgres": "3.88.0",
    "@payloadcms/email-resend": "3.88.0",
    "@payloadcms/next": "3.88.0",
    "@payloadcms/plugin-nested-docs": "3.88.0",
    "@payloadcms/richtext-lexical": "3.88.0",
    "@payloadcms/storage-s3": "3.88.0",
    "@payloadcms/ui": "3.88.0",
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-collapsible": "^1.1.20",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-focus-scope": "^1.1.16",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-radio-group": "^1.4.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-toast": "^1.2.23",
    "@t3-oss/env-nextjs": "^0.13.11",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "nanoid": "^5.1.16",
    "next": "16.3.2",
    "payload": "3.88.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.85.0",
    "sharp": "^0.35.3",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "nano-staged": "^1.0.2",
    "oxfmt": "^0.64.0",
    "oxlint": "^1.79.0",
    "oxlint-tsgolint": "^0.25.0",
    "simple-git-hooks": "^2.13.1",
    "stylelint": "^17.14.1",
    "stylelint-config-clean-order": "^10.0.0",
    "stylelint-config-standard": "^40.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec nano-staged"
  },
  "nano-staged": {
    "{apps,packages}/**/*.{ts,tsx,js,jsx,mjs,cjs}": [
      "oxlint --fix",
      "oxfmt"
    ],
    "{apps,packages}/**/*.css": [
      "stylelint --fix",
      "oxfmt"
    ],
    "*.!(ts|tsx|js|jsx|mjs|cjs|css)": "oxfmt --no-error-on-unmatched-pattern"
  },
  "packageManager": "pnpm@11.8.0"
}
